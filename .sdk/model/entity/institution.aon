# Entity: institution

main: kit: entity: institution: {

  alias: field: {}

  fields: [
    {
      name: "address"
      req: false
      type: "`$STRING`"
    }
    {
      name: "country"
      req: false
      type: "`$STRING`"
    }
    {
      name: "departments"
      req: false
      short: "Sub-resource (InstitutionDepartments); see the DreamApply SDK."
      type: "`$OBJECT`"
    }
    {
      name: "erasmus"
      req: false
      type: "`$STRING`"
    }
    {
      name: "iban"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "location"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "registration"
      req: false
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      type: "`$STRING`"
    }
    {
      name: "vat"
      req: false
      type: "`$STRING`"
    }
    {
      name: "www"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "institution"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/institutions"
          segments: [
            {
              lit: "institutions"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/institutions/{id}"
          segments: [
            {
              lit: "institutions"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.departments`"
          }
        }
      ]
    }
  }



}
