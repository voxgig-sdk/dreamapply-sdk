      h: "Www"
      n: "www"
      r: false
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "institution"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /institutions"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/institutions"
          s: [
            {
              lit: "institutions"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /institutions/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/institutions/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "institutions"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.departments`"
          }
        }
      ]
    }
  }



}
