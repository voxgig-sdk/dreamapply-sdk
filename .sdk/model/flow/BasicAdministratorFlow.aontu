# BasicAdministratorFlow

main: kit: flow: BasicAdministratorFlow:
{
  entity: "administrator",
  kind: "basic",
  name: "BasicAdministratorFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "administrator_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "administrator_ref01",
        srcdatavar: "administrator_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "administrator01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-administrator_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAdministratorFlow"
}