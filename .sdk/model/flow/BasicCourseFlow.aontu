# BasicCourseFlow

main: kit: flow: BasicCourseFlow:
{
  entity: "course",
  kind: "basic",
  name: "BasicCourseFlow",
  step: [
    {
      i: {
        ref: "course_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "course_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "course_ref01",
        srcdatavar: "course_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "course01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-course_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCourseFlow"
}